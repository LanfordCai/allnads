# Server Configuration
PORT=3000
NODE_ENV=development

# OpenRouter API Configuration
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY
OPENROUTER_MODEL=anthropic/claude-3.7-sonnet

# Optional: Logging Configuration
LOG_LEVEL=info 

# API Authentication
SERVICE_API_KEY=YOUR_SERVICE_API_KEY

# PostgreSQL Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=allnads

# Privy Authentication Configuration
PRIVY_APP_ID=YOUR_PRIVY_APP_ID
PRIVY_APP_SECRET=YOUR_PRIVY_APP_SECRET

# Blockchain Configuration
MONAD_TESTNET_RPC=YOUR_MONAD_TESTNET_RPC
MONAD_TESTNET_ALLNADS_CONTRACT_ADDRESS=YOUR_MONAD_TESTNET_ALLNADS_CONTRACT_ADDRESS
MONAD_TESTNET_ALLNADS_COMPONENT_CONTRACT_ADDRESS=0x8DF326e1E7c06F9236B98CE94aeb9eaB2f0B1Cbd
MONAD_TESTNET_AIRDROPPER_CONTRACT_ADDRESS=0x03aa2CC7A0aB626a7BAb9AD64E9F8c91dEA8635E

# Airdropper Configuration
MONAD_AIRDROPPER_ADDRESS=YOUR_MONAD_AIRDROPPER_ADDRESS
MONAD_AIRDROPPER_PRIVATE_KEY=YOUR_MONAD_AIRDROPPER_PRIVATE_KEY

# MCP Tools URLs
EMV_TOOL_URL=YOUR_EMV_TOOL_URL
ALLNADS_TOOL_URL=YOUR_ALLNADS_TOOL_URL